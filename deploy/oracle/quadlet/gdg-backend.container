[Unit]
Description=GDG backend
StartLimitIntervalSec=0

[Container]
Image=localhost/gdg-backend:active
ContainerName=gdg-backend
Network=gdg.network
EnvironmentFile=%h/.config/gdg/backend.env
NoNewPrivileges=true
DropCapability=all
LogDriver=journald

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=180

[Install]
WantedBy=default.target
